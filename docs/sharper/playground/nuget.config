<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Filled by .devcontainer/sharper/setup.sh from the latest Sharper release. -->
    <add key="sharper" value="/opt/sharper/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="sharper">
      <package pattern="Microsoft.Net.Compilers.Toolset" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
