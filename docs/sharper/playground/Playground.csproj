<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Sharper compiler. It compiles .cx files as Sharper and adds **/*.cx to Compile. The version floats to the
      newest package in the local feed of nuget.config, which .devcontainer/sharper/setup.sh fills.
    -->
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="*-*" PrivateAssets="all" />
  </ItemGroup>

</Project>
